         <children>
            <Button fx:id="btnImagem1" alignment="CENTER" maxHeight="130.0" maxWidth="160.0" minHeight="130.0" minWidth="160.0" mnemonicParsing="false" onAction="#abrirImagem1" prefHeight="130.0" prefWidth="160.0">
               <graphic>
                  <ImageView fitHeight="111.0" fitWidth="115.0" pickOnBounds="true" preserveRatio="true">
