            <Button fx:id="btnImagem2" maxHeight="130.0" maxWidth="160.0" minHeight="130.0" minWidth="160.0" mnemonicParsing="false" onAction="#abrirImagem2" prefHeight="130.0" prefWidth="160.0" GridPane.columnIndex="1">
               <graphic>
                  <ImageView fitHeight="111.0" fitWidth="115.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imagens/2.jpg" />
                     </image>
                  </ImageView>
