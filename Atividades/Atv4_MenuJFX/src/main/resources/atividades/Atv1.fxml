<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="150.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="atividades.Atv1Controller">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" text="Atividade 1">
         <VBox.margin>
            <Insets bottom="5.0" left="45.0" right="3.0" top="10.0" />
         </VBox.margin>
      </Label>
      <Label text="Número 1" />
      <TextField fx:id="txtN1" />
      <Label text="Número 2" />
      <TextField fx:id="txtN2" />
      <Button mnemonicParsing="false" onAction="#calcular" text="Calcular" />
      <Label fx:id="lblResultado" text="Resultado: " />
      <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
   </children>
</VBox>
